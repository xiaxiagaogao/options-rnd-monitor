# options-rnd-monitor 配置模板
# 复制本文件为 .env 并填入你自己的值。.env 已被 .gitignore，不会进版本库。
# 留空的项按“可选/降级”处理（见各行注释）。

# ── 数据源 ──
THETADATA_API_KEY=          # ThetaData 期权 EOD 数据（核心管线必填）
POLYGON_API_KEY=            # Polygon 辅源（可选）

# ── 面板鉴权 ──
SESSION_SECRET=             # FastAPI 会话签名密钥（必填，填一段随机长串）
DASHBOARD_PASSWORD=         # 仪表盘登录口令（必填）

# ── 研究助手 LLM（OpenAI 兼容中转）──
ASSISTANT_API_KEY=          # LLM API key（不填则助手端点返回未配置）
ASSISTANT_BASE_URL=         # 中转 base_url（OpenAI 兼容）
ASSISTANT_MODEL=            # 模型 id，如 claude-opus-5-5
ASSISTANT_EFFORT=           # reasoning effort，如 max

# ── Telegram 推送（可选）──
TELEGRAM_BOT_TOKEN=         # Bot token（不填则跳过所有 TG 推送）
TELEGRAM_CHAT_ID=           # 目标 chat id（配了 token 就必须配这个）

# ── 持仓同步（可选，读币安基金看板的 fund.db）──
FUND_DB_PATH=               # fund.db 路径；不填/不存在 → 持仓同步降级 no-op

# ── 本机代理（可选）──
RND_GRPC_PROXY=             # Clash TUN 等环境下 ThetaData gRPC 走的混合端口代理；裸连环境留空
